.tab-bar{position:fixed;bottom:0;left:0;right:0;z-index:999;background:#FFFFFF;border-top:1px solid #E8E8E8;padding-bottom:env(safe-area-inset-bottom)}
.tab-bar-inner{display:flex;height:50px}
.tab-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}
.tab-icon{width:24px;height:24px}
.tab-text{font-size:10px;color:#8A8AA0;margin-top:2px}
.tab-item.active .tab-text{color:#4A6CF7;font-weight:500}
.tab-item.active .tab-icon{filter:brightness(0) saturate(100%) invert(36%) sepia(97%) saturate(748%) hue-rotate(218deg) brightness(97%) contrast(101%)}
.tab-badge{position:absolute;top:2px;right:50%;margin-right:-18px;min-width:16px;height:16px;background:#FF5252;color:#fff;font-size:10px;border-radius:8px;text-align:center;line-height:16px;padding:0 4px}