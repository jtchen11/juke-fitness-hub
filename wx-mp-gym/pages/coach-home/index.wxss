.page-coach-home{padding:20px 16px 70px;min-height:100vh;background:#F5F6FA;box-sizing:border-box}.page-header{margin-bottom:8px}.summary-bar{display:flex;align-items:baseline;margin-bottom:16px;padding:16px;background:#FFF;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.summary-count{font-size:36px;font-weight:700;color:#4A6CF7;margin-right:8px}
.summary-label{font-size:14px;color:#8A8AA0}.page-title{font-size:20px;font-weight:600;color:#1A1A2E}.page-date{font-size:12px;color:#8A8AA0;margin-top:4px;display:block}.schedule-card{background:#FFF;border-radius:12px;padding:12px 16px;margin-bottom:12px;display:flex;align-items:center;box-shadow:0 2px 12px rgba(0,0,0,.06)}.schedule-time{font-size:14px;font-weight:600;color:#4A6CF7;width:60px;flex-shrink:0}.schedule-info{flex:1}.schedule-name{font-size:16px;color:#1A1A2E;display:block}.schedule-member{font-size:12px;color:#8A8AA0;margin-top:2px;display:block}.schedule-status{font-size:12px;padding:2px 8px;border-radius:4px;display:inline-block;margin-top:4px}.schedule-status.scheduled{background:#FFF3E0;color:#FFB300}.schedule-status.completed{background:#E8F5E9;color:#00C853}.schedule-status.cancelled{background:#F5F5F5;color:#BDBDBD}.empty-state{text-align:center;padding:60px 0;color:#8A8AA0;font-size:14px}