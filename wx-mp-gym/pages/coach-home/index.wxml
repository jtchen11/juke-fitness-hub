<view class="page-coach-home">
  <view class="page-header">
    <text class="page-title">今日课表</text>
    <text class="page-date">{{dateDisplay}}</text>
  </view>
  <view class="summary-bar">
    <text class="summary-count">{{schedules.length}}</text>
    <text class="summary-label">节课 · {{completedCount}}节已完成</text>
  </view>
  <scroll-view class="schedule-list" scroll-y>
    <view class="schedule-card" wx:for="{{schedules}}" wx:key="id" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="goDetail">
      <view class="schedule-time">{{item.time}}</view>
      <view class="schedule-info">
        <text class="schedule-name">{{item.name}}</text>
        <text class="schedule-member">{{item.memberName || '待确认'}}</text>
        <view class="schedule-status {{item.status}}">{{item.statusText}}</view>
      </view>
      <view wx:if="{{item.type==='group' && item.status==='scheduled'}}" class="code-btn-wrap" data-id="{{item.id}}" bindtap="generateCode" catchtap>
        <text class="code-btn-text">生成签到码</text>
      </view>
    </view>
    <view wx:if="{{schedules.length===0}}" class="empty-state"><text>今日暂无课程安排</text></view>
  </scroll-view>
  <tab-bar/>
</view>
