<view class="page-my-bookings">
  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-list">
      <view class="filter-item {{filter==='all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">??</view>
      <view class="filter-item {{filter==='booked' ? 'active' : ''}}" data-filter="booked" bindtap="onFilter">???</view>
      <view class="filter-item {{filter==='checked_in' ? 'active' : ''}}" data-filter="checked_in" bindtap="onFilter">???</view>
      <view class="filter-item {{filter==='completed' ? 'active' : ''}}" data-filter="completed" bindtap="onFilter">???</view>
      <view class="filter-item {{filter==='cancelled' ? 'active' : ''}}" data-filter="cancelled" bindtap="onFilter">???</view>
    </view>
  </scroll-view>

  <view class="list-area">
    <view wx:if="{{list.length===0}}" class="empty-state"><text>??????</text></view>
    <view class="booking-card" wx:for="{{list}}" wx:key="id">
      <view class="card-top">
        <view class="card-left">
          <text class="card-type">{{item.typeLabel}}</text>
          <text class="card-name">{{item.name}}</text>
          <text class="card-trainer">{{item.trainerName}}</text>
          <text class="card-time">{{item.bookingTime}}</text>
        </view>
        <view class="status-tag {{item.status}}">{{statusText(item.status)}}</view>
      </view>
      <view class="card-actions" wx:if="{{item.status==='booked'}}">
        <button class="btn-cancel" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="onCancel">????</button>
        <button class="btn-checkin" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="onCheckin">??</button>
      </view>
    </view>
  </view>
  <tab-bar/>
</view>