<view class="page-my-bookings">
  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-list">
      <view class="filter-item {{filter==='all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">全部</view>
      <view class="filter-item {{filter==='booked' ? 'active' : ''}}" data-filter="booked" bindtap="onFilter">已预约</view>
      <view class="filter-item {{filter==='checked_in' ? 'active' : ''}}" data-filter="checked_in" bindtap="onFilter">已签到</view>
      <view class="filter-item {{filter==='completed' ? 'active' : ''}}" data-filter="completed" bindtap="onFilter">已完成</view>
      <view class="filter-item {{filter==='cancelled' ? 'active' : ''}}" data-filter="cancelled" bindtap="onFilter">已取消</view>
    </view>
  </scroll-view>

  <view class="list-area">
    <view wx:if="{{list.length===0}}" class="empty-state"><text>暂无预约记录</text></view>
    <view class="booking-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="goDetail">
      <view class="card-top">
        <view class="card-left">
          <text class="card-type">{{item.typeLabel}}</text>
          <text class="card-name">{{item.name}}</text>
          <text class="card-trainer">{{item.trainerName}}</text>
          <text class="card-time">{{item.bookingTime}}</text>
        </view>
        <view class="status-tag {{item.status}}">{{statusText(item.status)}}</view>
      </view>
      <view class="card-actions" wx:if="{{item.status==='booked'}}">
        <button class="btn-cancel" data-id="{{item.id}}" data-type="{{item.type}}" catchtap="onCancel">取消预约</button>
        <button class="btn-checkin" data-id="{{item.id}}" data-type="{{item.type}}" catchtap="onCheckin">签到</button>
      </view>
    </view>
  </view>

  <!-- 签到码弹窗 -->
  <view class="code-mask" wx:if="{{showCodeInput}}" catchtap="hideCodeInput">
    <view class="code-modal" catchtap="stopPropagation">
      <view class="code-modal-content">
        <text class="code-modal-title">签到验证</text>
        <text class="code-modal-desc">请输入教练提供的6位签到码</text>
        <input class="code-input" type="text" maxlength="6" value="{{checkinCode}}" bindinput="onCodeInput" placeholder="输入6位签到码" catchtap="stopPropagation"/>
        <button class="btn-primary" bindtap="submitCheckinCode" loading="{{codeLoading}}">确认签到</button>
        <button class="btn-cancel" catchtap="hideCodeInput">取消</button>
      </view>
    </view>
  </view>

  <tab-bar/>
</view>
