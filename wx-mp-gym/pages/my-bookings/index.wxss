.nav-bar{display:flex;align-items:center;padding:calc(20rpx + env(safe-area-inset-top)) 20rpx 12rpx;background:#FFF}.nav-back{display:flex;align-items:center}.back-icon{font-size:48rpx;color:#4A6CF7;line-height:1}.back-text{font-size:28rpx;color:#4A6CF7;margin-left:4rpx}.page-my-bookings{min-height:100vh;background:#F5F6FA}
.filter-scroll{white-space:nowrap;padding:20rpx 32rpx;background:#FFF}
.filter-list{display:inline-flex;gap:8rpx}
.filter-item{padding:12rpx 28rpx;font-size:26rpx;color:#8A8AA0;background:#F5F6FA;border-radius:8px;display:inline-block}
.filter-item.active{background:rgba(74,108,247,0.08);color:#4A6CF7;font-weight:600}
.list-area{padding:16rpx 32rpx}
.booking-card{background:#FFF;border-radius:12px;padding:24rpx;margin-bottom:16rpx;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.card-top{display:flex;justify-content:space-between}
.card-left{flex:1;min-width:0}
.card-type{font-size:22rpx;color:#4A6CF7;font-weight:500;display:block;margin-bottom:4rpx}
.card-name{font-size:30rpx;font-weight:600;color:#1A1A2E;display:block;margin-bottom:6rpx}
.card-trainer{font-size:24rpx;color:#8A8AA0;display:block;margin-bottom:4rpx}
.card-time{font-size:22rpx;color:#8A8AA0;display:block}.card-order-time{font-size:20rpx;color:#BDBDBD;display:block;margin-top:4rpx}
.status-tag{font-size:22rpx;padding:6rpx 16rpx;border-radius:4px;height:fit-content;flex-shrink:0}
.status-tag.booked{background:#FFF3E0;color:#FFB300}
.status-tag.checked_in{background:#E8F5E9;color:#00C853}
.status-tag.completed{background:#EEF0FF;color:#4A6CF7}
.status-tag.cancelled{background:#F5F5F5;color:#BDBDBD}
.card-actions{display:flex;gap:16rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #E8E8E8}
.btn-cancel{flex:1;height:72rpx;background:#FFF;border:2rpx solid #E8E8E8;border-radius:8px;color:#8A8AA0;font-size:26rpx;line-height:72rpx;text-align:center}
.btn-checkin{flex:1;height:72rpx;background:#4A6CF7;border-radius:8px;color:#FFF;font-size:26rpx;font-weight:600;line-height:72rpx;text-align:center;border:none}
.empty-state{text-align:center;padding:80rpx 0;font-size:28rpx;color:#8A8AA0}

/* 签到码弹窗 */
.code-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:999}
.code-modal{background:#FFF;border-radius:16px;padding:40rpx 48rpx;width:560rpx;text-align:center}
.code-modal-title{font-size:36rpx;font-weight:600;color:#1A1A2E;display:block;margin-bottom:12rpx}
.code-modal-desc{font-size:26rpx;color:#8A8AA0;display:block;margin-bottom:32rpx}
.code-input{width:100%;height:80rpx;border:2rpx solid #E8E8E8;border-radius:8px;font-size:36rpx;text-align:center;letter-spacing:12rpx;margin-bottom:32rpx;box-sizing:border-box}
.btn-primary{width:100%;height:80rpx;background:#4A6CF7;border-radius:8px;color:#FFF;font-size:30rpx;font-weight:600;line-height:80rpx;border:none;margin-bottom:16rpx}
.btn-cancel{width:100%;height:72rpx;background:#FFF;border-radius:8px;color:#8A8AA0;font-size:26rpx;line-height:72rpx;border:2rpx solid #E8E8E8}
