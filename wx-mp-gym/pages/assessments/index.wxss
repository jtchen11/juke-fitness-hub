.page-assessments{min-height:100vh;background:#F5F6FA;padding:20px 16px 70px}.header{margin-bottom:20px}.header-title{font-size:24px;font-weight:700;color:#1A1A2E;display:block}.header-desc{font-size:14px;color:#8A8AA0;display:block;margin-top:4px}.record-card{background:#FFF;border-radius:12px;padding:16px;margin-bottom:10px;box-shadow:0 2px 12px rgba(0,0,0,.06)}.record-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.record-date{font-size:16px;font-weight:500;color:#1A1A2E}.record-score{font-size:20px;font-weight:700;padding:2px 10px;border-radius:6px}.record-score.excellent{color:#00C853;background:#E8F5E9}.record-score.good{color:#4A6CF7;background:#EEF0FF}.record-score.pass{color:#FFB300;background:#FFF3E0}.record-score.needs_improvement{color:#FF5252;background:#FFEBEE}.record-metrics{display:flex;gap:16px}.metric{font-size:13px;color:#8A8AA0}.empty{text-align:center;padding:60px 0;color:#8A8AA0;font-size:14px}