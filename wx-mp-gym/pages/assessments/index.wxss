.page-assessments{min-height:100vh;background:#F5F6FA;padding:calc(24rpx + env(safe-area-inset-top)) 24rpx 70rpx;box-sizing:border-box}
.nav-bar{display:flex;align-items:center;height:80rpx;margin-bottom:16rpx}
.nav-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;background:#FFF;border-radius:50%;box-shadow:0 2rpx 12rpx rgba(0,0,0,.06)}
.back-icon{font-size:40rpx;color:#1A1A2E;line-height:1;font-weight:700;margin-top:-4rpx}
.nav-title{font-size:34rpx;font-weight:700;color:#1A1A2E;margin-left:16rpx}
.profile-card{display:flex;background:linear-gradient(135deg,#4A6CF7,#6C8CFF);border-radius:24rpx;padding:32rpx 0;margin-bottom:24rpx}
.profile-item{flex:1;text-align:center;border-right:1rpx solid rgba(255,255,255,.25)}
.profile-item:last-child{border-right:none}
.profile-label{display:block;font-size:24rpx;color:rgba(255,255,255,.8);margin-bottom:8rpx}
.profile-value{display:block;font-size:36rpx;font-weight:700;color:#FFF}
.profile-unit{font-size:22rpx;font-weight:400;color:rgba(255,255,255,.75);margin-left:4rpx}
.metric-row{display:flex;gap:20rpx;margin-bottom:24rpx}
.metric-card{flex:1;background:#FFF;border-radius:20rpx;padding:24rpx 0 20rpx;text-align:center;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.metric-label{display:block;font-size:24rpx;color:#8A8AA0;margin-bottom:12rpx}
.metric-value-wrap{display:flex;align-items:baseline;justify-content:center}
.metric-value{font-size:44rpx;font-weight:700;color:#1A1A2E}
.metric-unit{font-size:22rpx;color:#8A8AA0;margin-left:4rpx}
.metric-delta{display:block;margin-top:10rpx;font-size:22rpx}
.metric-delta.good{color:#00C853}
.metric-delta.bad{color:#FF5252}
.chart-card{background:#FFF;border-radius:20rpx;padding:24rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.chart-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}
.chart-title{font-size:30rpx;font-weight:700;color:#1A1A2E}
.legend{display:flex;gap:16rpx}
.legend-item{display:flex;align-items:center;font-size:20rpx;color:#8A8AA0}
.legend-dot{width:16rpx;height:16rpx;border-radius:50%;margin-right:6rpx}
.dot-weight{background:#4A6CF7}
.dot-fat{background:#FF9800}
.dot-muscle{background:#00C853}
.trend-canvas{width:100%;height:360rpx}
.chart-empty{text-align:center;padding:80rpx 0 40rpx;color:#8A8AA0;font-size:24rpx}
.history-section{margin-top:8rpx}
.section-title{display:block;font-size:30rpx;font-weight:700;color:#1A1A2E;margin-bottom:16rpx}
.record-card{display:flex;justify-content:space-between;align-items:center;background:#FFF;border-radius:20rpx;padding:24rpx;margin-bottom:16rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.record-left{display:flex;flex-direction:column;gap:8rpx}
.record-date{font-size:30rpx;font-weight:600;color:#1A1A2E}
.record-remark{font-size:22rpx;color:#4A6CF7}
.record-right{display:flex;gap:28rpx}
.record-metric{text-align:center}
.rm-label{display:block;font-size:20rpx;color:#8A8AA0;margin-bottom:6rpx}
.rm-value{font-size:24rpx;font-weight:600;color:#1A1A2E}
.empty{text-align:center;padding:60rpx 0;color:#8A8AA0;font-size:26rpx}
.empty.retry{color:#4A6CF7}
