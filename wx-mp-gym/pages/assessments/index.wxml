<view class="page-assessments"><view class="header"><text class="header-title">体测记录</text><text class="header-desc">查看每次体测的详细报告</text></view><view class="list"><view class="record-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail"><view class="record-top"><text class="record-date">{{item.testDate}}</text><view class="record-score {{scoreGrade(item.totalScore)}}">{{item.totalScore || '-'}}分</view></view><view class="record-metrics"><text class="metric">BMI: {{item.bmi || '-'}}</text><text class="metric">体脂: {{item.bodyFatPercent || '-'}}%</text><text class="metric">肌肉: {{item.muscleMassKg || '-'}}kg</text></view></view></view><view wx:if="{{records.length===0}}" class="empty"><text>暂无体测记录</text></view></view>