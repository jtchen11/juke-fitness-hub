.page-face-checkin{min-height:100vh;background:#1A1A2E;display:flex;flex-direction:column}
.camera-area{flex:1;position:relative;overflow:hidden}
.camera{width:100%;height:100%}
.camera-mask{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center}
.face-frame{width:240px;height:300px;border:2px solid rgba(255,255,255,.3);border-radius:16px}
.status-bar{padding:16px;text-align:center}
.status-text{font-size:14px;color:#FFF}
.action-area{padding:16px 32px 40px;text-align:center}
.btn-capture{width:180px;height:48px;background:linear-gradient(135deg,#4A6CF7,#8B5CF6);color:#FFF;border:none;border-radius:24px;font-size:16px;font-weight:600;display:inline-flex;align-items:center;justify-content:center}
.btn-capture::after{border:none}
.action-hint{font-size:12px;color:rgba(255,255,255,.5);display:block;margin-top:12px}