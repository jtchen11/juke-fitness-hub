.page-ai-chat{display:flex;flex-direction:column;height:100vh;background:#F5F6FA;width:100%;box-sizing:border-box;overflow-x:hidden}
.chat-header{padding:20px 20px 12px;text-align:center;background:#FFF;width:100%;box-sizing:border-box}
.chat-title{font-size:20px;font-weight:600;color:#1A1A2E;display:block}
.chat-subtitle{font-size:12px;color:#8A8AA0;display:block;margin-top:4px}
.quick-ask{white-space:nowrap;padding:8px 16px;background:#FFF;width:100%;box-sizing:border-box}
.quick-chip{display:inline-flex;align-items:center;padding:6px 14px;margin-right:8px;background:#EEF0FF;border-radius:16px;font-size:12px;color:#4A6CF7;white-space:nowrap}
.chat-messages{flex:1;min-width:0;width:100%;padding:16px 16px 0;overflow-y:auto;box-sizing:border-box;overflow-x:hidden}
.date-divider{text-align:center;padding:12px 0;font-size:12px;color:#BDBDBD}
.msg{margin-bottom:16px;display:flex;max-width:100%;box-sizing:border-box}
.msg-ai{justify-content:flex-start}
.msg-user{justify-content:flex-end}
.msg-avatar{width:32px;height:32px;border-radius:50%;background:#4A6CF7;color:#FFF;font-size:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:8px}
.msg-user .msg-avatar{background:#8B5CF6;order:1;margin-right:0;margin-left:8px}
.msg-bubble{max-width:80%;word-break:break-all;background:#FFF;border-radius:12px;padding:10px 14px;font-size:14px;color:#1A1A2E;line-height:1.6;box-shadow:0 2px 8px rgba(0,0,0,.06);overflow-wrap:break-word;word-wrap:break-word;white-space:pre-wrap}
.msg-user .msg-bubble{background:#4A6CF7;color:#FFF}
.streaming-dots{animation:blink 1.2s infinite;display:inline}
@keyframes blink{0%,100%{opacity:0}50%{opacity:1}}
.chat-spacer{height:140px;width:100%}
.chat-input-bar{position:fixed;bottom:50px;left:0;right:0;display:flex;padding:8px 12px;background:#FFF;border-top:1px solid #E8E8E8;align-items:center;padding-bottom:calc(8px + env(safe-area-inset-bottom));z-index:999;box-sizing:border-box}
.chat-input{flex:1;min-width:0;height:36px;background:#F5F6FA;border-radius:18px;padding:0 14px;font-size:14px;color:#1A1A2E}
.btn-send{width:56px;height:36px;background:#4A6CF7;color:#FFF;border:none;border-radius:18px;font-size:14px;display:flex;align-items:center;justify-content:center;margin-left:8px;flex-shrink:0}
.btn-send::after{border:none}
.btn-cancel{width:56px;height:36px;background:#FF6B6B;color:#FFF;border:none;border-radius:18px;font-size:13px;display:flex;align-items:center;justify-content:center;margin-left:8px;flex-shrink:0}
.btn-cancel::after{border:none}
/* 支付按钮 */
.payment-buttons {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}
.payment-btn {
  background: #f0f5ff;
  border: 1rpx solid #b3d4ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.payment-btn:active {
  background: #d6e6ff;
}
.payment-sub {
  color: #666;
  font-size: 24rpx;
  margin-left: 8rpx;
}