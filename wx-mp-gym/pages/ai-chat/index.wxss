.page-ai-chat{display:flex;flex-direction:column;height:100vh;background:#F5F6FA}.chat-header{padding:40px 20px 16px;text-align:center;background:#FFF}.chat-title{font-size:20px;font-weight:600;color:#1A1A2E;display:block}.chat-subtitle{font-size:12px;color:#8A8AA0;display:block;margin-top:4px}.chat-messages{flex:1;padding:16px;overflow-y:auto;padding-bottom:70px}.msg{margin-bottom:16px;display:flex}.msg-ai{justify-content:flex-start}.msg-user{justify-content:flex-end}.msg-avatar{width:32px;height:32px;border-radius:50%;background:#4A6CF7;color:#FFF;font-size:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:8px}.msg-user .msg-avatar{background:#8B5CF6;order:1;margin-right:0;margin-left:8px}.msg-bubble{max-width:75%;background:#FFF;border-radius:12px;padding:10px 14px;font-size:14px;color:#1A1A2E;line-height:1.6;box-shadow:0 2px 8px rgba(0,0,0,.06)}.msg-user .msg-bubble{background:#4A6CF7;color:#FFF}.chat-input-bar{display:flex;padding:8px 12px;background:#FFF;border-top:1px solid #E8E8E8;align-items:center;padding-bottom:calc(8px + env(safe-area-inset-bottom))}.chat-input{flex:1;height:36px;background:#F5F6FA;border-radius:18px;padding:0 14px;font-size:14px;color:#1A1A2E}.btn-send{width:56px;height:36px;background:#4A6CF7;color:#FFF;border:none;border-radius:18px;font-size:14px;display:flex;align-items:center;justify-content:center;margin-left:8px}.btn-send::after{border:none}