.page-mine{padding-top:env(safe-area-inset-top);min-height:100vh;background:#F5F6FA}
.profile-card{display:flex;align-items:center;background:#FFF;margin:32rpx;padding:32rpx;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#4A6CF7;display:flex;align-items:center;justify-content:center;margin-right:24rpx}
.avatar-text{font-size:40rpx;color:#FFF;font-weight:600}
.profile-info{flex:1}
.profile-name{font-size:34rpx;color:#1A1A2E;font-weight:600;display:block}
.profile-level{font-size:22rpx;color:#4A6CF7;margin-top:6rpx;display:block}
.profile-arrow{font-size:40rpx;color:#8A8AA0}
.benefits-card{display:flex;align-items:center;background:#FFF;margin:0 32rpx 24rpx;padding:24rpx 32rpx;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.benefit-item{flex:1;text-align:center}
.benefit-num{font-size:36rpx;font-weight:700;color:#4A6CF7;display:block}
.benefit-label{font-size:22rpx;color:#8A8AA0;margin-top:6rpx;display:block}
.benefit-divider{width:2rpx;height:48rpx;background:#E8E8E8}
/* 分区标题 */
.section-title-bar{padding:16rpx 32rpx 12rpx}
.section-title-text{font-size:28rpx;font-weight:600;color:#1A1A2E}
/* 服务项目网格 */
.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:0 32rpx 24rpx}
.service-item{display:flex;flex-direction:column;align-items:center;background:#FFF;border-radius:12px;padding:28rpx 16rpx;box-shadow:0 2px 8px rgba(0,0,0,0.04)}
.service-item{position:relative}
.msg-badge{position:absolute;top:14rpx;right:36rpx;min-width:32rpx;height:32rpx;padding:0 8rpx;border-radius:16rpx;background:#FF4D4F;color:#FFF;font-size:20rpx;line-height:32rpx;text-align:center}
.service-icon{font-size:40rpx;margin-bottom:8rpx}
.service-text{font-size:24rpx;color:#1A1A2E}
/* 个人数据 */
.personal-data{background:#FFF;margin:0 32rpx 24rpx;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.04);overflow:hidden}
.data-item{display:flex;align-items:center;padding:24rpx 32rpx;border-bottom:1rpx solid #E8E8E8}
.data-item:last-child{border-bottom:none}
.data-icon{font-size:36rpx;margin-right:20rpx}
.data-info{flex:1}
.data-name{font-size:28rpx;color:#1A1A2E;display:block}
.data-desc{font-size:22rpx;color:#8A8AA0;margin-top:4rpx;display:block}
.data-arrow{font-size:32rpx;color:#8A8AA0}
.menu-group{background:#FFF;margin:0 32rpx;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.04);overflow:hidden}
.menu-item{display:flex;align-items:center;padding:28rpx 32rpx;border-bottom:1rpx solid #E8E8E8;font-size:28rpx;color:#1A1A2E}
.menu-item:last-child{border-bottom:none}
.menu-icon{margin-right:20rpx;font-size:32rpx}
.menu-arrow{margin-left:auto;color:#8A8AA0}
.btn-logout{width:calc(100% - 64rpx);margin:48rpx 32rpx;height:88rpx;background:#FFF;border-radius:8px;color:#FF5252;font-size:32rpx;line-height:88rpx;border:2rpx solid #E8E8E8}
.login-prompt{display:flex;flex-direction:column;align-items:center;padding:160rpx 64rpx 0}
.prompt-avatar{width:120rpx;height:120rpx;border-radius:50%;background:#E8E8E8;display:flex;align-items:center;justify-content:center;margin-bottom:32rpx}
.prompt-avatar-text{font-size:48rpx;color:#8A8AA0}
.prompt-title{font-size:34rpx;color:#1A1A2E;font-weight:600;margin-bottom:12rpx}
.prompt-desc{font-size:26rpx;color:#8A8AA0;text-align:center;margin-bottom:48rpx}
.btn-primary{width:100%;height:88rpx;background:#4A6CF7;border-radius:8px;color:#FFF;font-size:32rpx;font-weight:600;line-height:88rpx;border:none}
.profile-status{font-size:22rpx;margin-top:4rpx;display:inline-block;padding:2rpx 12rpx;border-radius:4rpx}
.profile-status.active{color:#00C853;background:rgba(0,200,83,0.08)}
.profile-status.inactive{color:#FFB300;background:rgba(255,179,0,0.08)}
.upgrade-banner{background:linear-gradient(135deg,#667eea,#4A6CF7);border-radius:12px;padding:24rpx 32rpx;margin:0 32rpx 24rpx}
.upgrade-title{font-size:28rpx;font-weight:600;color:#FFF;display:block;margin-bottom:8rpx}
.upgrade-desc{font-size:24rpx;color:rgba(255,255,255,0.8);display:block}
.profile-status.expired{color:#FF5252;background:rgba(255,82,82,0.08)}
.profile-status.visitor{color:#FFB300;background:rgba(255,179,0,0.08)}
.upgrade-banner.expired{background:linear-gradient(135deg,#FF5252,#FF6B6B)}
.page-home,.page-courses,.page-bookings,.page-mine,.page-bookings-list{padding-bottom:70px}
.switch-section{padding:16px 16px 0;text-align:center}
.btn-switch{width:100%;height:44px;background:#EEF0FF;color:#4A6CF7;border:none;border-radius:8px;font-size:16px;font-weight:500;display:flex;align-items:center;justify-content:center}
.btn-switch::after{border:none}
.switch-hint{font-size:12px;color:#8A8AA0;display:block;margin-top:8px;text-align:center}
.avatar-img{width:100rpx;height:100rpx;border-radius:50%}

.expired-badge{font-size:11px;color:#FFF;background:#FF4757;padding:2px 8px;border-radius:4px;display:inline-block;margin-left:8px}
.level-row{display:flex;align-items:center;margin-top:4px}
