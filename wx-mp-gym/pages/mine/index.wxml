<view class="page-mine">   <block wx:if="{{isLoggedIn}}">     <view class="profile-card" bindtap="showLogin">       <view class="avatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"/>
        <text wx:else class="avatar-text">{{memberName[0] || '?'}}</text>
      </view>       <view class="profile-info">         <text class="profile-name">{{memberName}}</text>         <text class="profile-level">{{level}}</text>         <text class="profile-status {{isActiveMember ? 'active' : (isExpired ? 'expired' : 'visitor')}}">           {{isActiveMember ? '正式会员' : (isExpired ? '已过期' : '访客')}}         </text>       </view>       <view class="profile-arrow">></view>     </view>      <block wx:if="{{isVisitor}}">       <view class="upgrade-banner">         <text class="upgrade-title">您还没有办理会员卡</text>         <text class="upgrade-desc">免费体验课已开放，办卡后可预约全部课程</text>       </view>     </block>     <block wx:elif="{{isExpired}}">       <view class="upgrade-banner expired">         <text class="upgrade-title">会员卡已过期</text>         <text class="upgrade-desc">立即续费，恢复全部权益</text>       </view>     </block>      <view class="menu-group">       <view class="menu-item" bindtap="goBookings"><text class="menu-icon">📋</text><text>我的预约</text><text class="menu-arrow">></text></view>
      <view class="menu-item" bindtap="goFaceCheckin"><text class="menu-icon">🗣</text><text>刷脸打卡</text><text class="menu-arrow">></text></view>       <view class="menu-item" bindtap="goPackages"><text class="menu-icon">📦</text><text>课程包</text><text class="menu-arrow">></text></view>       <view class="menu-item" bindtap="goFitnessTest"><text class="menu-icon">📊</text><text>体测记录</text><text class="menu-arrow">></text></view>
      <view class="menu-item" bindtap="goCompetitions"><text class="menu-icon">🏆</text><text>比赛活动</text><text class="menu-arrow">></text></view>     </view>     <button class="btn-logout" bindtap="onLogout">退出登录</button>   </block>   <block wx:else>     <view class="login-prompt">       <view class="prompt-avatar"><text class="prompt-avatar-text">?</text></view>       <text class="prompt-title">登录智能健身房</text>       <text class="prompt-desc">登录后即可预约课程、查看训练记录</text>       <button class="btn-primary" bindtap="showLogin">登录</button>     </view>   </block> <view class="switch-section" wx:if="{{canSwitchToCoach}}"><button class="btn-switch" bindtap="switchToCoach">切换到教练模式</button><text class="switch-hint">切换到教练端管理课表和学员</text></view>
  <tab-bar/> </view>