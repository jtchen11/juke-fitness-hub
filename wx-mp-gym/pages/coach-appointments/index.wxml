<view class="page-coach-appts"><view class="page-header"><text class="page-title">预约管理</text></view><view class="filter-bar"><view class="filter-chip {{statusFilter==='' ? 'active' : ''}}" data-status="" bindtap="filterStatus">全部</view><view class="filter-chip {{statusFilter==='scheduled' ? 'active' : ''}}" data-status="scheduled" bindtap="filterStatus">待上课</view><view class="filter-chip {{statusFilter==='completed' ? 'active' : ''}}" data-status="completed" bindtap="filterStatus">已完成</view><view class="filter-chip {{statusFilter==='checked_in' ? 'active' : ''}}" data-status="checked_in" bindtap="filterStatus">已核销</view></view><scroll-view class="appt-list" scroll-y><view class="appt-card" wx:for="{{appointments}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail"><view class="appt-top"><text class="appt-name">{{item.memberName}}</text><text class="appt-time">{{item.time}}</text></view><text class="appt-type">{{item.type==='pt'?'私教':'团课'}} - {{item.courseName}}</text><view class="appt-actions" wx:if="{{item.status==='scheduled'}}"><button class="btn-sm btn-checkin" data-id="{{item.id}}" data-memberid="{{item.memberId}}" bindtap="onCheckIn">上课打卡</button><button class="btn-sm btn-cancel" data-id="{{item.id}}" bindtap="onCancel">取消</button></view><view class="appt-actions" wx:elif="{{item.status==='ongoing'}}"><button class="btn-sm btn-ongoing" disabled>已上课</button></view></view><view wx:if="{{appointments.length===0}}" class="empty-state"><text>暂无预约</text></view></scroll-view><tab-bar/></view>