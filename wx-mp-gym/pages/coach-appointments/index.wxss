.page-coach-appts{padding:20px 16px 70px;min-height:100vh;background:#F5F6FA;box-sizing:border-box}.page-header{margin-bottom:16px}.page-title{font-size:20px;font-weight:600;color:#1A1A2E}.filter-bar{display:flex;gap:8px;margin-bottom:16px}.filter-chip{padding:4px 12px;border-radius:12px;font-size:12px;color:#8A8AA0;background:#FFF;border:1px solid #E8E8E8}.filter-chip.active{color:#4A6CF7;border-color:#4A6CF7;background:#EEF0FF}.appt-card{background:#FFF;border-radius:12px;padding:12px 16px;margin-bottom:12px;box-shadow:0 2px 12px rgba(0,0,0,.06)}.appt-top{display:flex;justify-content:space-between;margin-bottom:4px}.appt-name{font-size:16px;font-weight:500;color:#1A1A2E}.appt-time{font-size:12px;color:#8A8AA0}.appt-type{font-size:12px;color:#8A8AA0;display:block;margin-bottom:8px}.appt-actions{display:flex;gap:8px;margin-top:8px}.btn-sm{padding:4px 12px;border-radius:6px;font-size:12px;border:none;flex:1}.btn-checkin{background:#4A6CF7;color:#FFF}.btn-cancel{background:#F5F5F5;color:#8A8AA0}.btn-ongoing{background:#E8E8E8;color:#8A8AA0;border:none}
.empty-state{text-align:center;padding:60px 0;color:#8A8AA0;font-size:14px}