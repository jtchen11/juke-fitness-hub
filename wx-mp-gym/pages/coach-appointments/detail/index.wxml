<view class="page-appt-detail">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹ 返回</view>
    <text class="nav-title">预约详情</text>
    <view class="nav-placeholder"></view>
  </view>
  <view class="detail-card" wx:if="{{appt.id}}">
    <view class="detail-header">
      <text class="detail-member">{{appt.memberName || '会员'}}</text>
      <text class="detail-status {{appt.status}}">{{statusText}}</text>
    </view>
    <view class="info-row"><text class="info-label">课程</text><text class="info-value">{{appt.courseName || appt.name}}</text></view>
    <view class="info-row"><text class="info-label">类型</text><text class="info-value">{{appt.type==='pt'?'私教':'团课'}}</text></view>
    <view class="info-row"><text class="info-label">时间</text><text class="info-value">{{appt.time}}</text></view>
    <view class="info-row"><text class="info-label">教练</text><text class="info-value">{{appt.trainerName || '我'}}</text></view>
    <view class="info-row"><text class="info-label">备注</text><text class="info-value">{{appt.remark || '无'}}</text></view>
  </view>
    <view class="action-bar" wx:if="{{appt.status==='scheduled'}}">
    <button class="btn-checkin" bindtap="onCheckIn">上课打卡</button>
    <button class="btn-checkout" bindtap="onCheckOut">下课打卡</button>
    <button class="btn-cancel" bindtap="onCancel">取消预约</button>
  </view>
  <view class="action-bar" wx:elif="{{appt.status==='completed'}}">
    <text class="done-text">课程已完成</text>
  </view>
  <view wx:if="{{!appt.id}}" class="empty-state"><text>加载中...</text></view>
</view>
