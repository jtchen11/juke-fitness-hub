.page-appt-detail{min-height:100vh;background:#F5F6FA;padding-bottom:100px}
.nav-bar{display:flex;align-items:center;padding:calc(20px + env(safe-area-inset-top)) 16px 12px;background:#FFF}
.nav-back{font-size:16px;color:#4A6CF7;padding:4px 0}
.nav-title{flex:1;text-align:center;font-size:18px;font-weight:600;color:#1A1A2E}
.nav-placeholder{width:60px}
.detail-card{background:#FFF;margin:16px;border-radius:12px;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.detail-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid #E8E8E8}
.detail-member{font-size:20px;font-weight:600;color:#1A1A2E}
.detail-status{font-size:12px;padding:4px 12px;border-radius:4px}
.detail-status.scheduled{background:#FFF3E0;color:#FFB300}
.detail-status.completed{background:#E8F5E9;color:#00C853}
.detail-status.cancelled{background:#F5F5F5;color:#BDBDBD}
.info-row{display:flex;padding:12px 0;border-bottom:1px solid #F5F5F5}
.info-label{width:80px;font-size:14px;color:#8A8AA0;flex-shrink:0}
.info-value{font-size:14px;color:#1A1A2E;flex:1}
.action-bar{position:fixed;bottom:0;left:0;right:0;display:flex;gap:12px;padding:12px 16px;padding-bottom:calc(12px + env(safe-area-inset-bottom));background:#FFF;border-top:1px solid #E8E8E8}
.action-bar .btn-checkin{flex:1;height:44px;background:#4A6CF7;color:#FFF;border:none;border-radius:8px;font-size:16px;font-weight:600}
.action-bar .btn-checkout{flex:1;height:44px;background:#FFB300;color:#FFF;border:none;border-radius:8px;font-size:16px;font-weight:600}
.action-bar .btn-cancel{flex:1;height:44px;background:#FFF;color:#8A8AA0;border:1px solid #E8E8E8;border-radius:8px;font-size:16px}
.done-text{text-align:center;padding:80px 0;color:#00C853;font-size:16px;font-weight:600}
.empty-state{text-align:center;padding:80px 0;color:#8A8AA0;font-size:14px}
