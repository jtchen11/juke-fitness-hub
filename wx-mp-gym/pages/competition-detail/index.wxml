<view class="page-comp-detail"><view class="header"><text class="comp-name">{{comp.name}}</text><text class="comp-status {{comp.status}}">{{statusText}}</text></view><view class="info-card"><view class="info-row"><text class="info-label">比赛时间</text><text class="info-value">{{comp.startDate}} ~ {{comp.endDate}}</text></view><view class="info-row"><text class="info-label">报名费</text><text class="info-value">{{comp.fee ? '¥'+comp.fee : '免费'}}</text></view></view><view class="desc-card"><text class="desc-title">比赛介绍</text><text class="desc-content">{{comp.description || '暂无介绍'}}</text></view><button class="btn-register" wx:if="{{comp.status==='open'}}" bindtap="onRegister" disabled="{{registered}}">{{registered ? '已报名' : '立即报名'}}</button></view>