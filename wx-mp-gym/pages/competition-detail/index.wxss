.page-comp-detail{min-height:100vh;background:#F5F6FA;padding-bottom:70px}
.nav-bar{display:flex;align-items:center;padding:calc(20rpx + env(safe-area-inset-top)) 20rpx 12rpx;background:#FFF}
.nav-back{display:flex;align-items:center}
.back-icon{font-size:48rpx;color:#4A6CF7;line-height:1}
.nav-title{flex:1;text-align:center;font-size:32rpx;font-weight:600;color:#1A1A2E}
.nav-placeholder{width:80rpx}
.content{padding:20rpx 32rpx 40rpx}.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.comp-name{font-size:24px;font-weight:700;color:#1A1A2E;flex:1}.comp-status{font-size:12px;padding:4px 10px;border-radius:4px}.comp-status.open{background:#E8F5E9;color:#00C853}.comp-status.active{background:#EEF0FF;color:#4A6CF7}.comp-status.ended{background:#F5F5F5;color:#BDBDBD}.info-card,.desc-card{background:#FFF;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 12px rgba(0,0,0,.06)}.info-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #F5F5F5}.info-row:last-child{border-bottom:none}.info-label{font-size:14px;color:#8A8AA0}.info-value{font-size:14px;color:#1A1A2E;font-weight:500}.desc-title{font-size:16px;font-weight:600;color:#1A1A2E;display:block;margin-bottom:8px}
.prize-card{background:#FFF;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.prize-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #F5F5F5}
.prize-row:last-child{border-bottom:none}
.prize-label{font-size:14px;color:#8A8AA0}
.prize-value{font-size:14px;color:#4A6CF7;font-weight:600}.desc-content{font-size:14px;color:#1A1A2E;line-height:1.6;display:block}.btn-register{width:100%;height:48px;background:#4A6CF7;color:#FFF;border:none;border-radius:8px;font-size:16px;font-weight:600;margin-top:12px}.btn-register::after{border:none}.btn-register[disabled]{background:#CCC}