<view class="login-page">
  <view class="login-header">
    <text class="app-name">桔刻健身</text>
    <text class="app-desc">登录后即可预约课程、查看训练记录</text>
  </view>

  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
    </button>
    <text class="avatar-hint">点击设置头像</text>
  </view>

  <view class="form-section">
    <input class="nickname-input" type="nickname" placeholder="请输入昵称" bindinput="onNicknameInput" value="{{nickname}}" />

    <view class="input-group">
      <text class="input-label">手机号</text>
      <input class="input-field" type="number" maxlength="11" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{phone}}" bindconfirm="onPhoneConfirm" />
    </view>

    <view class="input-group code-group">
      <text class="input-label">验证码</text>
      <view class="code-row">
        <input class="input-field code-input" type="number" maxlength="6" placeholder="请输入验证码" bindinput="onCodeInput" value="{{code}}" />
        <button class="code-btn {{countdown > 0 ? 'disabled' : ''}}" disabled="{{countdown > 0}}" bindtap="sendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>

    <button class="login-btn" bindtap="onLogin" loading="{{loading}}" disabled="{{!phone || !code}}">
      登录
    </button>
  </view>

  <view class="agreement">
    <text class="agreement-text">登录即代表同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view>
</view>