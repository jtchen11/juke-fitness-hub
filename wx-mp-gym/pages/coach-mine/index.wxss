.page-coach-mine{min-height:100vh;background:#F5F6FA;padding-bottom:70px}
.profile-card{display:flex;align-items:center;background:#FFF;margin:calc(20px + env(safe-area-inset-top)) 16px 12px;padding:20px;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.avatar{width:60px;height:60px;border-radius:50%;background:#4A6CF7;display:flex;align-items:center;justify-content:center;margin-right:16px}
.avatar-text{font-size:24px;color:#FFF;font-weight:600}
.profile-info{flex:1}
.profile-name{font-size:18px;font-weight:600;color:#1A1A2E;display:block}
.profile-level{font-size:12px;color:#8A8AA0;margin-top:2px;display:block}
.profile-status{font-size:12px;padding:2px 8px;border-radius:4px;display:inline-block;margin-top:4px}
.profile-status.active{background:#E8F5E9;color:#00C853}
.stats-bar{display:flex;background:#FFF;margin:0 16px 12px;padding:16px;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.stat-item{flex:1;text-align:center}
.stat-num{font-size:24px;font-weight:700;color:#4A6CF7;display:block}
.stat-label{font-size:12px;color:#8A8AA0;margin-top:4px;display:block}
.menu-group{background:#FFF;margin:0 16px;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.04);overflow:hidden}
.menu-item{display:flex;align-items:center;padding:16px;border-bottom:1px solid #E8E8E8;font-size:16px;color:#1A1A2E}
.menu-item:last-child{border-bottom:none}
.menu-icon{margin-right:12px;font-size:20px}
.menu-arrow{margin-left:auto;color:#8A8AA0}
.switch-section{padding:16px;text-align:center}
.btn-switch{width:100%;height:44px;background:#EEF0FF;color:#4A6CF7;border:none;border-radius:8px;font-size:16px;font-weight:500}
.btn-switch::after{border:none}
.switch-hint{font-size:12px;color:#8A8AA0;display:block;margin-top:8px;text-align:center}
.btn-logout{width:calc(100% - 32px);margin:0 16px 48px;height:44px;background:#FFF;border-radius:8px;color:#FF5252;font-size:16px;line-height:44px;border:1px solid #E8E8E8}
