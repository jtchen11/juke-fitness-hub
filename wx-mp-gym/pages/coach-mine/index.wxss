.page-coach-mine{padding:20px 16px 70px;min-height:100vh;background:#F5F6FA;box-sizing:border-box}.profile-card{background:#FFF;border-radius:12px;padding:20px 16px;display:flex;align-items:center;margin-bottom:16px;box-shadow:0 2px 12px rgba(0,0,0,.06)}.avatar{width:56px;height:56px;border-radius:50%;background:#4A6CF7;display:flex;align-items:center;justify-content:center;flex-shrink:0}.avatar-text{font-size:24px;font-weight:600;color:#FFF}.profile-info{margin-left:12px}.profile-name{font-size:18px;font-weight:600;color:#1A1A2E;display:block}.profile-level{font-size:14px;color:#8A8AA0;display:block;margin-top:2px}.profile-status{font-size:12px;padding:2px 8px;border-radius:4px;display:inline-block;margin-top:4px}.profile-status.active{background:#E8F5E9;color:#00C853}.menu-group{background:#FFF;border-radius:12px;overflow:hidden;margin-bottom:16px;box-shadow:0 2px 12px rgba(0,0,0,.06)}.menu-item{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid #F5F5F5}.menu-item:last-child{border-bottom:none}.menu-icon{font-size:18px;margin-right:12px}.menu-arrow{margin-left:auto;color:#CCC;font-size:14px}.switch-section{margin-bottom:20px;text-align:center}.btn-switch{width:100%;height:44px;background:#EEF0FF;color:#4A6CF7;border:none;border-radius:8px;font-size:16px;font-weight:500;display:flex;align-items:center;justify-content:center}.btn-switch::after{border:none}.switch-hint{font-size:12px;color:#8A8AA0;display:block;margin-top:8px;text-align:center}.btn-logout{width:100%;height:44px;background:#FFF;color:#FF5252;border:1px solid #FF5252;border-radius:8px;font-size:14px;margin-top:8px;display:flex;align-items:center;justify-content:center}.btn-logout::after{border:none}.empty-state{text-align:center;padding:60px 0;color:#8A8AA0;font-size:14px}