.page-leave{min-height:100vh;background:#F5F6FA;padding:20px 16px}.nav-bar{padding:12px 0 20px}.nav-back{display:flex;align-items:center;gap:8px;font-size:16px;color:#333;font-weight:600}.form{background:#FFF;border-radius:12px;padding:20px}.form-item{margin-bottom:20px}.form-label{font-size:14px;font-weight:600;color:#1A1A2E;display:block;margin-bottom:8px}.picker-value{font-size:16px;color:#333;padding:10px 12px;background:#F5F6FA;border-radius:8px}.period-list{display:flex;gap:10px}.period-item{flex:1;text-align:center;padding:10px;border-radius:8px;background:#F5F6FA;font-size:14px;color:#666}.period-item.active{background:#4A6CF7;color:#FFF}.reason-input{width:100%;height:120px;padding:12px;font-size:14px;background:#F5F6FA;border:none;border-radius:8px;box-sizing:border-box}.btn-submit{width:100%;height:48px;background:#4A6CF7;color:#FFF;border:none;border-radius:8px;font-size:16px;font-weight:600;margin-top:20px}.btn-submit::after{border:none}