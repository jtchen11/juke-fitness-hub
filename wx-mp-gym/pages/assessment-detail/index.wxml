<view class="page-assessment-detail"><view class="score-section"><text class="total-score">{{record.totalScore || '-'}}</text><text class="score-label">综合评分</text><view class="score-bar"><view class="bar-fill" style="width:{{record.totalScore||0}}%"></view></view><text class="score-grade {{gradeClass}}">{{gradeText}}</text></view><view class="metrics-grid"><view class="metric-card"><text class="metric-value">{{record.bmi || '-'}}</text><text class="metric-label">BMI</text><text class="metric-score">{{record.bmiScore || 0}}/50</text></view><view class="metric-card"><text class="metric-value">{{record.bodyFatPercent || '-'}}%</text><text class="metric-label">体脂率</text><text class="metric-score">{{record.fatScore || 0}}/50</text></view><view class="metric-card"><text class="metric-value">{{record.muscleMassKg || '-'}}kg</text><text class="metric-label">肌肉量</text><text class="metric-score">-</text></view><view class="metric-card"><text class="metric-value">{{record.weightKg || '-'}}kg</text><text class="metric-label">体重</text><text class="metric-score">{{record.testDate}}</text></view></view><view class="suggestion-card" wx:if="{{report.aiSuggestion}}"><text class="suggestion-title">AI 健康建议</text><text class="suggestion-content">{{report.aiSuggestion}}</text></view></view>