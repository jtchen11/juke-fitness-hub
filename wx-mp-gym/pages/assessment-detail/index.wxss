.page-assessment-detail{min-height:100vh;background:#F5F6FA;padding:20px 16px 70px}.score-section{background:linear-gradient(135deg,#4A6CF7,#8B5CF6);border-radius:16px;padding:32px;text-align:center;margin-bottom:20px}.total-score{font-size:64px;font-weight:700;color:#FFF;display:block}.score-label{font-size:14px;color:rgba(255,255,255,.7);display:block;margin-top:4px}.score-bar{height:6px;background:rgba(255,255,255,.2);border-radius:3px;margin:16px 20px 8px;overflow:hidden}.bar-fill{height:100%;background:#FFF;border-radius:3px;transition:width .5s}.score-grade{font-size:16px;font-weight:600;display:inline-block;padding:4px 16px;border-radius:12px}.score-grade.excellent{color:#FFF;background:rgba(0,200,83,.4)}.score-grade.good{color:#FFF;background:rgba(74,108,247,.4)}.score-grade.pass{color:#FFF;background:rgba(255,179,0,.4)}.score-grade.needs_improvement{color:#FFF;background:rgba(255,82,82,.4)}.metrics-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}.metric-card{background:#FFF;border-radius:12px;padding:16px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,.06)}.metric-value{font-size:24px;font-weight:700;color:#1A1A2E;display:block}.metric-label{font-size:12px;color:#8A8AA0;display:block;margin-top:4px}.metric-score{font-size:12px;color:#4A6CF7;display:block;margin-top:2px}.suggestion-card{background:#FFF;border-radius:12px;padding:16px;box-shadow:0 2px 12px rgba(0,0,0,.06)}.suggestion-title{font-size:16px;font-weight:600;color:#1A1A2E;display:block;margin-bottom:8px}.suggestion-content{font-size:14px;color:#1A1A2E;line-height:1.8;white-space:pre-wrap}