.page-assessment-detail{min-height:100vh;background:#F5F6FA;padding:calc(24rpx + env(safe-area-inset-top)) 24rpx 70rpx;box-sizing:border-box}
.nav-bar{display:flex;align-items:center;height:80rpx;margin-bottom:16rpx}
.nav-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;background:#FFF;border-radius:50%;box-shadow:0 2rpx 12rpx rgba(0,0,0,.06)}
.back-icon{font-size:40rpx;color:#1A1A2E;line-height:1;font-weight:700;margin-top:-4rpx}
.nav-title{font-size:34rpx;font-weight:700;color:#1A1A2E;margin-left:16rpx}
.header-card{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#4A6CF7,#6C8CFF);border-radius:24rpx;padding:32rpx;margin-bottom:24rpx}
.header-date{display:block;font-size:40rpx;font-weight:700;color:#FFF}
.header-desc{display:block;font-size:24rpx;color:rgba(255,255,255,.8);margin-top:8rpx}
.status-badge{font-size:26rpx;color:#4A6CF7;background:#FFF;border-radius:30rpx;padding:10rpx 24rpx;font-weight:600}
.metrics-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-bottom:24rpx}
.metric-card{background:#FFF;border-radius:20rpx;padding:24rpx;text-align:center;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.metric-label{display:block;font-size:24rpx;color:#8A8AA0;margin-bottom:12rpx}
.metric-value-row{display:flex;align-items:baseline;justify-content:center}
.metric-value{font-size:44rpx;font-weight:700;color:#1A1A2E}
.metric-unit{font-size:22rpx;color:#8A8AA0;margin-left:4rpx}
.metric-delta{display:block;margin-top:10rpx;font-size:22rpx}
.metric-delta.good{color:#00C853}
.metric-delta.bad{color:#FF5252}
.metric-delta.flat{color:#9AA0B4}
.compare-card{background:#FFF;border-radius:20rpx;padding:24rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.compare-title{display:block;font-size:30rpx;font-weight:700;color:#1A1A2E;margin-bottom:8rpx}
.compare-sub{display:block;font-size:22rpx;color:#8A8AA0;margin-bottom:16rpx}
.compare-grid{display:flex;gap:20rpx}
.compare-item{flex:1;text-align:center;background:#F7F8FC;border-radius:16rpx;padding:16rpx 0}
.ci-label{display:block;font-size:22rpx;color:#8A8AA0;margin-bottom:8rpx}
.ci-value{display:block;font-size:28rpx;font-weight:600;color:#1A1A2E}
.ci-value.good{color:#00C853}
.ci-value.bad{color:#FF5252}
.ci-value.flat{color:#9AA0B4}
.suggestion-card{background:#FFF;border-radius:20rpx;padding:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.suggestion-title{display:block;font-size:30rpx;font-weight:700;color:#1A1A2E;margin-bottom:12rpx}
.suggestion-content{font-size:26rpx;color:#1A1A2E;line-height:1.8;white-space:pre-wrap;word-break:break-all}.score-card{background:#FFF;border-radius:20rpx;padding:24rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}.score-top{display:flex;align-items:center;gap:16rpx;margin-bottom:20rpx}.score-icon{font-size:48rpx}.score-num-wrap{display:flex;align-items:baseline}.score-num{font-size:56rpx;font-weight:700;color:#1A1A2E}.score-unit{font-size:22rpx;color:#8A8AA0;margin-left:4rpx}.score-grade{margin-left:auto;font-size:26rpx;font-weight:600;padding:8rpx 20rpx;border-radius:24rpx}.grade-excellent{color:#00C853;background:#E8F5E9}.grade-good{color:#4A6CF7;background:#EEF0FF}.grade-needs_improvement{color:#FF9800;background:#FFF3E0}.score-dims{display:flex;flex-direction:column;gap:16rpx}.dim-row{display:flex;align-items:center;gap:16rpx}.dim-name{width:90rpx;font-size:24rpx;color:#8A8AA0}.dim-bar{flex:1;height:12rpx;background:#F0F1F5;border-radius:6rpx;overflow:hidden}.dim-fill{height:100%;border-radius:6rpx}.fill-bmi{background:#4A6CF7}.fill-fat{background:#FF9800}.fill-muscle{background:#00C853}.dim-score{width:100rpx;text-align:right;font-size:24rpx;font-weight:600;color:#1A1A2E}