.page-points{min-height:100vh;background:#F5F6FA;padding:calc(24rpx + env(safe-area-inset-top)) 32rpx 70rpx;box-sizing:border-box}
.nav-bar{display:flex;align-items:center;height:80rpx;margin-bottom:20rpx;position:relative}
.nav-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;background:#FFF;border-radius:50%;box-shadow:0 2rpx 12rpx rgba(0,0,0,.06)}
.back-icon{font-size:40rpx;color:#1A1A2E;line-height:1;font-weight:700;margin-top:-4rpx}
.nav-title{font-size:34rpx;font-weight:700;color:#1A1A2E;margin-left:16rpx}
.nav-right{position:absolute;right:0;top:50%;transform:translateY(-50%);font-size:26rpx;color:#4A6CF7;font-weight:600}
.points-header{background:#FFF;border-radius:24rpx;padding:48rpx 32rpx;text-align:center;margin-bottom:40rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.points-num{font-size:88rpx;font-weight:700;color:#4A6CF7;display:block;line-height:1.2}
.points-label{font-size:24rpx;color:#8A8AA0;display:block;margin-top:12rpx}
.section{margin-bottom:40rpx}
.section-title{font-size:32rpx;font-weight:600;color:#1A1A2E;display:block;margin-bottom:20rpx}
.reward-card{background:#FFF;border-radius:20rpx;padding:24rpx;display:flex;margin-bottom:16rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}
.reward-card.disabled{opacity:.55}
.reward-img{width:120rpx;height:120rpx;border-radius:16rpx;margin-right:20rpx;flex-shrink:0;background:#F0F1F5}
.reward-main{flex:1;display:flex;flex-direction:column;min-width:0}
.reward-name{font-size:30rpx;font-weight:600;color:#1A1A2E;display:block}
.reward-desc{font-size:24rpx;color:#8A8AA0;display:block;margin-top:8rpx;line-height:1.5;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.reward-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}
.reward-price{display:flex;align-items:baseline}
.price-num{font-size:36rpx;font-weight:700;color:#4A6CF7}
.price-label{font-size:22rpx;color:#8A8AA0;margin-left:6rpx}
.stock-label{font-size:20rpx;color:#FF9500;margin-left:12rpx}
.redeem-btn{min-width:120rpx;height:56rpx;padding:0 24rpx;display:flex;align-items:center;justify-content:center;background:#4A6CF7;border-radius:28rpx;font-size:24rpx;color:#FFF;font-weight:600}
.redeem-btn.btn-disabled{background:#C9CEDC;color:#FFF}
.history-item{background:#FFF;border-radius:16rpx;padding:20rpx 24rpx;display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.03)}
.history-left{flex:1;min-width:0}
.history-type{font-size:26rpx;color:#1A1A2E;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.history-time{font-size:22rpx;color:#8A8AA0;display:block;margin-top:4rpx}
.history-points{font-size:30rpx;font-weight:700}
.history-points.add{color:#4A6CF7}
.history-points.sub{color:#FF4757}
.empty{font-size:24rpx;color:#8A8AA0;text-align:center;padding:40rpx 0}
