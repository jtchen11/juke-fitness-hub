.page-points{min-height:100vh;background:#F5F6FA;padding:20px 16px 70px}
.points-header{background:linear-gradient(135deg,#4A6CF7,#8B5CF6);border-radius:16px;padding:32px;text-align:center;margin-bottom:20px}
.points-num{font-size:56px;font-weight:700;color:#FFF;display:block}
.points-label{font-size:14px;color:rgba(255,255,255,0.8);display:block;margin-top:8px}
.section{margin-bottom:20px}
.section-title{font-size:18px;font-weight:600;color:#1A1A2E;display:block;margin-bottom:12px}
.redeem-card{background:#FFF;border-radius:12px;padding:16px;display:flex;align-items:center;margin-bottom:10px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.redeem-info{flex:1}
.redeem-name{font-size:16px;font-weight:500;color:#1A1A2E;display:block}
.redeem-desc{font-size:12px;color:#8A8AA0;display:block;margin-top:4px}
.redeem-cost{text-align:center;flex-shrink:0;margin-left:12px}
.cost-num{font-size:24px;font-weight:700;color:#FFB300;display:block}
.cost-label{font-size:12px;color:#8A8AA0;display:block}
.history-item{background:#FFF;border-radius:12px;padding:12px 16px;display:flex;align-items:center;margin-bottom:8px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.history-left{flex:1}
.history-type{font-size:14px;color:#1A1A2E;display:block}
.history-time{font-size:12px;color:#8A8AA0;display:block;margin-top:2px}
.history-points{font-size:18px;font-weight:600}
.history-points.add{color:#00C853}
.history-points.sub{color:#FF5252}
.empty{text-align:center;padding:40px 0;color:#8A8AA0;font-size:14px}