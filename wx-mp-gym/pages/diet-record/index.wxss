.page-diet{min-height:100vh;background:#F5F6FA;padding:20px 16px 70px}
.section-title{font-size:16px;font-weight:600;color:#1A1A2E;display:block;margin-bottom:12px}
.add-card{background:#FFF;border-radius:12px;padding:16px;margin-bottom:16px}
.picker-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #F0F0F0}
.picker-row .label{font-size:14px;color:#666}
.picker-row .value{font-size:14px;color:#333}
.meal-select{display:flex;gap:8px;margin:12px 0}
.meal-item{flex:1;text-align:center;padding:10px;border-radius:8px;background:#F5F6FA;font-size:13px;color:#666}
.meal-item.active{background:#4A6CF7;color:#FFF}
.food-input{width:100%;padding:12px;background:#F5F6FA;border:none;border-radius:8px;font-size:14px;margin-bottom:10px;box-sizing:border-box}
.btn-submit{width:100%;height:44px;background:#4A6CF7;color:#FFF;border:none;border-radius:8px;font-size:15px;font-weight:600;margin-top:4px}.btn-submit::after{border:none}
.record-list{background:#FFF;border-radius:12px;padding:16px}
.record-card{padding:12px 0;border-bottom:1px solid #F0F0F0;position:relative}
.record-top{display:flex;justify-content:space-between;margin-bottom:4px}
.record-meal{font-size:14px;font-weight:600;color:#333}
.record-date{font-size:12px;color:#999}
.record-food{font-size:14px;color:#666;display:block}
.record-calories{font-size:12px;color:#FF9500;display:block;margin-top:2px}
.del-btn{position:absolute;right:0;top:12px;font-size:12px;color:#FF4757;padding:4px 8px}
.empty{font-size:14px;color:#999;text-align:center;padding:30px 0}