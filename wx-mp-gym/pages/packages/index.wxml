<view class="page-packages">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack"><text class="back-icon">‹</text></view>
    <text class="nav-title">课程包</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="section">
    <text class="section-title">可购买课程包</text>
    <view wx:if="{{shopList.length===0}}" class="empty-state"><text>暂无可购买课程包</text></view>
    <view class="shop-card" wx:for="{{shopList}}" wx:key="id" data-id="{{item.id}}" bindtap="buyPackage">
      <view class="shop-left">
        <text class="shop-name">{{item.name}}</text>
        <text class="shop-desc">{{item.description}}</text>
        <view class="shop-meta">
          <text class="shop-sessions">{{item.sessions}}节课</text>
          <text class="shop-valid">有效期{{item.validDays}}天</text>
        </view>
      </view>
      <view class="shop-right">
        <text class="shop-price">¥{{item.price}}</text>
        <text class="shop-buy">购买</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">我的课程包</text>
    <view wx:if="{{list.length===0}}" class="empty-state"><text>暂无课程包</text></view>
    <view class="pkg-card" wx:for="{{list}}" wx:key="id">
      <view class="pkg-top">
        <text class="pkg-name">{{item.packageName}}</text>
        <text class="pkg-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="pkg-progress">
        <view class="progress-bar"><view class="progress-fill" style="width:{{item.usedSessions/item.totalSessions*100}}%"></view></view>
        <text class="progress-text">{{item.usedSessions}}/{{item.totalSessions}}节</text>
      </view>
      <view class="pkg-info">
        <text wx:if="{{item.endDate}}" class="pkg-expiry">有效期至：{{item.endDate}}</text>
        <text class="pkg-remaining">剩余 {{item.remainingSessions}} 节</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showPayModal}}" class="pay-overlay" catchtap="closePayModal">
    <view class="pay-modal" catchtap="">
      <view class="pay-modal-header">
        <text class="pay-modal-title">确认购买</text>
        <text class="pay-modal-sub">请确认课程包信息</text>
      </view>
      <view class="pay-modal-body">
        <view class="pay-info-row">
          <text class="pay-label">课程包名称</text>
          <text class="pay-value">{{payPkg.name}}</text>
        </view>
        <view class="pay-info-row">
          <text class="pay-label">课时/有效期</text>
          <text class="pay-value">{{payPkg.sessions}}节课 · {{payPkg.validDays}}天</text>
        </view>
        <view class="pay-info-row">
          <text class="pay-label">原价</text>
          <text class="pay-value pay-original">¥{{payOriginalPrice}}</text>
        </view>
        <view class="pay-divider"></view>
        <view class="pay-info-row pay-total-row">
          <text class="pay-label pay-total-label">实付金额</text>
          <text class="pay-value pay-total">¥{{payFinalPrice}}</text>
        </view>
        <text wx:if="{{payDiscount>0}}" class="pay-saved">已享{{payLevelName}}{{payDiscount}}%折扣</text>
        <text wx:else class="pay-saved">普通会员无折扣</text>
      </view>
      <view class="pay-modal-footer">
        <button class="pay-btn-cancel" bindtap="closePayModal">取消</button>
        <button class="pay-btn-confirm" bindtap="confirmBuy">确认购买</button>
      </view>
    </view>
  </view>
</view>
