.page-packages{min-height:100vh;background:#F5F6FA}
.nav-bar{display:flex;align-items:center;padding:calc(20rpx + env(safe-area-inset-top)) 20rpx 12rpx;background:#FFF}
.nav-back{display:flex;align-items:center}
.back-icon{font-size:48rpx;color:#4A6CF7;line-height:1}
.back-text{font-size:28rpx;color:#4A6CF7;margin-left:4rpx}
.nav-title{flex:1;text-align:center;font-size:32rpx;font-weight:600;color:#1A1A2E}
.nav-placeholder{width:80rpx}
.section{padding:20rpx 32rpx 0}
.section-title{font-size:30rpx;font-weight:600;color:#1A1A2E;display:block;margin-bottom:16rpx}
/* purchasable cards */
.shop-card{background:#FFF;border-radius:12px;padding:24rpx;margin-bottom:16rpx;display:flex;align-items:center;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.shop-left{flex:1}
.shop-name{font-size:30rpx;font-weight:600;color:#1A1A2E;display:block}
.shop-desc{font-size:24rpx;color:#8A8AA0;display:block;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.shop-meta{display:flex;gap:16rpx;margin-top:10rpx}
.shop-sessions{font-size:22rpx;color:#4A6CF7;background:rgba(74,108,247,0.06);padding:2rpx 12rpx;border-radius:4px}
.shop-valid{font-size:22rpx;color:#8A8AA0;background:#F5F6FA;padding:2rpx 12rpx;border-radius:4px}
.shop-right{text-align:center;margin-left:20rpx}
.shop-price{font-size:34rpx;font-weight:700;color:#FF5252;display:block}
.shop-buy{font-size:24rpx;color:#FFF;background:#4A6CF7;padding:8rpx 28rpx;border-radius:8px;display:inline-block;margin-top:8rpx}
/* owned packages */
.pkg-card{background:#FFF;border-radius:12px;padding:24rpx;margin-bottom:16rpx;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.pkg-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}
.pkg-name{font-size:30rpx;font-weight:600;color:#1A1A2E}
.pkg-status{font-size:22rpx;padding:4rpx 14rpx;border-radius:4px}
.pkg-status.active{background:rgba(0,200,83,0.08);color:#00C853}
.pkg-status.expired{background:rgba(255,82,82,0.08);color:#FF5252}
.pkg-progress{display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx}
.progress-bar{flex:1;height:12rpx;background:#E8E8E8;border-radius:6rpx;overflow:hidden}
.progress-fill{height:100%;background:#4A6CF7;border-radius:6rpx}
.progress-text{font-size:24rpx;color:#8A8AA0;flex-shrink:0}
.pkg-info{display:flex;justify-content:space-between}
.pkg-expiry{font-size:24rpx;color:#8A8AA0}
.pkg-remaining{font-size:24rpx;color:#4A6CF7;font-weight:600}
.empty-state{text-align:center;padding:60rpx 0;font-size:28rpx;color:#8A8AA0}
/* pay modal */
.pay-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:999;display:flex;align-items:center;justify-content:center}
.pay-modal{background:#FFF;border-radius:16px;width:620rpx;overflow:hidden}
.pay-modal-header{background:#4A6CF7;padding:36rpx 40rpx 28rpx;text-align:center;flex-shrink:0}
.pay-modal-title{font-size:36rpx;font-weight:700;color:#FFF;display:block}
.pay-modal-sub{font-size:24rpx;color:rgba(255,255,255,0.85);display:block;margin-top:8rpx}
.pay-modal-body{padding:8rpx 40rpx 0}
.pay-info-row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #F0F0F4}
.pay-label{font-size:28rpx;color:#8A8AA0;flex-shrink:0}
.pay-value{font-size:28rpx;color:#1A1A2E;font-weight:600;text-align:right;flex:1;margin-left:32rpx;word-break:break-all}
.pay-value.pay-original{color:#8A8AA0;text-decoration:line-through;font-weight:400}
.pay-divider{height:2rpx;background:#E8E8E8;margin:8rpx 0 0}
.pay-total-row{border-bottom:none;padding-top:28rpx;padding-bottom:12rpx}
.pay-total-label{font-size:30rpx;font-weight:600;color:#1A1A2E}
.pay-total{color:#4A6CF7;font-size:42rpx;font-weight:700}
.pay-saved{display:block;text-align:center;font-size:24rpx;color:#4A6CF7;padding-bottom:24rpx}
.pay-modal-footer{display:flex;gap:24rpx;padding:0 40rpx 40rpx}
.pay-btn-cancel{flex:1;height:88rpx;line-height:84rpx;font-size:30rpx;margin:0;background:#FFF;border:2rpx solid #E8E8E8;border-radius:8px;color:#8A8AA0;text-align:center}
.pay-btn-confirm{flex:1;height:88rpx;line-height:88rpx;font-size:30rpx;margin:0;background:#4A6CF7;border-radius:8px;color:#FFF;text-align:center}
.pkg-status.used{background:rgba(138,138,160,0.1);color:#8A8AA0}
.pkg-status.pending{background:rgba(255,152,0,0.1);color:#FF9800}
