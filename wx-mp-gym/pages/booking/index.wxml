<view class="page-booking">
  <!-- Cover Image -->
  <view class="cover-wrap">
    <image class="cover-img" src="{{coverImageUrl}}" mode="aspectFill"/>
    <view class="cover-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
  </view>

  <!-- Course Title + Tags -->
  <view class="title-section">
    <text class="course-title">{{course.name}}</text>
    <view class="tag-row">
      <text wx:if="{{course.difficulty}}" class="tag-difficulty tag-{{difficultyTag}}">{{course.difficulty}}</text>
      <text wx:if="{{course.allowVisitor}}" class="tag-experience">体验课</text>
    </view>
  </view>

  <!-- Trainer Info -->
  <view class="trainer-section">
    <image class="trainer-avatar" src="{{trainerAvatarUrl}}" mode="aspectFill"/>
    <view class="trainer-info">
      <text class="trainer-name">{{course.trainerName || '待定教练'}}</text>
      <text class="trainer-intro one-line">{{trainerIntro}}</text>
    </view>
  </view>

  <!-- Course Info Card -->
  <view class="info-card">
    <view class="info-row">
      <text class="info-label">时间</text>
      <text class="info-value">{{formattedTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">教室</text>
      <text class="info-value">{{course.classroom || '未指定'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">名额</text>
      <text class="info-value info-count">{{course.enrolled || 0}}/{{course.maxCapacity || 0}}</text>
    </view>
    <view class="info-row info-row-last">
      <text class="info-label">价格</text>
      <text wx:if="{{isExperienceFree}}" class="info-value tag-free">免费·体验课</text>
      <text wx:else class="info-value info-price">¥{{course.price || 0}}</text>
    </view>
  </view>

  <!-- Course Description -->
  <view class="desc-section" wx:if="{{course.description}}">
    <text class="section-title">课程简介</text>
    <text class="desc-text">{{course.description}}</text>
  </view>

  <!-- Bottom Button -->
  <view class="bottom-bar">
    <button class="btn-confirm" bindtap="confirmBooking" loading="{{loading}}">{{btnText}}</button>
  </view>

  <!-- Login Modal -->
  <view class="login-mask" wx:if="{{showLoginModal}}" bindtap="onLoginClose">
    <view class="login-modal" catchtap="">
      <text class="login-modal-title">请先登录</text>
      <text class="login-modal-desc">登录后即可预约课程</text>
      <button class="btn-primary" bindtap="onLogin">去登录</button>
      <button class="btn-cancel" bindtap="onLoginClose">取消</button>
    </view>
  </view>

  <!-- Pay Modal -->
  <view class="pay-mask" wx:if="{{showPayModal}}" catchtap="closePayModal">
    <view class="pay-modal" catchtap="">
      <view class="pay-modal-header">
        <text class="pay-modal-title">确认支付</text>
        <text class="pay-modal-sub">请确认以下课程信息</text>
      </view>
      <view class="pay-modal-body">
        <view class="pay-info-row">
          <text class="pay-label">课程名称</text>
          <text class="pay-value">{{payClassName}}</text>
        </view>
        <view class="pay-info-row">
          <text class="pay-label">原价</text>
          <text class="pay-value">¥{{payOriginalPrice}}</text>
        </view>
        <view class="pay-info-row" wx:if="{{payDiscountPct > 0}}">
          <text class="pay-label">{{payLevelName}}折扣</text>
          <text class="pay-value pay-discount">-¥{{payDiscount}}（{{payDiscountPct}}%）</text>
        </view>
        <view class="pay-divider"></view>
        <view class="pay-info-row pay-total-row">
          <text class="pay-label pay-total-label">实付金额</text>
          <text class="pay-value pay-total">¥{{payAmount}}</text>
        </view>
      </view>
      <view class="pay-modal-footer">
        <button class="btn-cancel pay-btn-cancel" bindtap="closePayModal">取消</button>
        <button class="btn-primary pay-btn-confirm" bindtap="confirmPay" loading="{{loading}}">确认支付</button>
      </view>
    </view>
  </view>
</view>
