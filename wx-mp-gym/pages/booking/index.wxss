.page-booking{min-height:100vh;background:#F5F6FA;padding-bottom:160rpx}

/* Cover Image */
.cover-wrap{position:relative;width:100%;height:35vh;overflow:hidden}
.cover-img{width:100%;height:100%}
.cover-back{position:absolute;top:calc(40rpx + env(safe-area-inset-top));left:24rpx;width:72rpx;height:72rpx;background:rgba(0,0,0,0.3);border-radius:50%;display:flex;align-items:center;justify-content:center}
.back-icon{font-size:48rpx;color:#FFF;line-height:1}

/* Title Section */
.title-section{background:#FFF;padding:28rpx 32rpx 20rpx}
.course-title{font-size:40rpx;font-weight:700;color:#1A1A2E;display:block;line-height:1.3}
.tag-row{display:flex;gap:12rpx;margin-top:16rpx}
.tag-difficulty{display:inline-block;padding:4rpx 16rpx;border-radius:4px;font-size:22rpx;font-weight:500}
.tag-beginner{background:rgba(0,200,83,0.08);color:#00C853}
.tag-intermediate{background:rgba(255,179,0,0.08);color:#FFB300}
.tag-advanced{background:rgba(255,82,82,0.08);color:#FF5252}
.tag-experience{display:inline-block;padding:4rpx 16rpx;border-radius:4px;font-size:22rpx;font-weight:500;background:rgba(255,149,0,0.1);color:#FF9500}

/* Trainer Section */
.trainer-section{display:flex;align-items:center;background:#FFF;padding:0 32rpx 24rpx;margin-bottom:16rpx}
.trainer-avatar{width:72rpx;height:72rpx;border-radius:50%;background:#F5F6FA;flex-shrink:0}
.trainer-info{flex:1;min-width:0;margin-left:16rpx}
.trainer-name{font-size:28rpx;font-weight:600;color:#1A1A2E;display:block}
.trainer-intro{font-size:24rpx;color:#8A8AA0;display:block;margin-top:4rpx}
.one-line{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Info Card */
.info-card{background:#FFF;border-radius:12px;margin:0 32rpx 24rpx;padding:0 32rpx;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.info-row{display:flex;justify-content:space-between;align-items:center;padding:28rpx 0;border-bottom:1rpx solid #E8E8E8}
.info-row-last{border-bottom:none}
.info-label{font-size:26rpx;color:#8A8AA0;flex-shrink:0}
.info-value{font-size:28rpx;color:#1A1A2E;text-align:right}
.info-count{font-weight:600}
.info-price{font-size:36rpx;font-weight:700;color:#4A6CF7}
.tag-free{font-size:26rpx;color:#00C853;font-weight:600;background:rgba(0,200,83,0.08);padding:4rpx 16rpx;border-radius:4px}

/* Description */
.desc-section{background:#FFF;border-radius:12px;margin:0 32rpx 24rpx;padding:28rpx 32rpx;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.section-title{font-size:28rpx;font-weight:600;color:#1A1A2E;display:block;margin-bottom:12rpx}
.desc-text{font-size:26rpx;color:#8A8AA0;line-height:1.6}

/* Bottom Bar */
.bottom-bar{position:fixed;bottom:0;left:0;right:0;padding:16rpx 32rpx;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));background:#FFF;box-shadow:0 -2rpx 12rpx rgba(0,0,0,0.04);z-index:100}
.btn-confirm{width:100%;height:88rpx;background:#4A6CF7;border-radius:8px;color:#FFF;font-size:32rpx;font-weight:600;line-height:88rpx;border:none;box-shadow:0 4rpx 12rpx rgba(74,108,247,0.3)}

/* Login Modal */
.login-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:999}
.login-modal{background:#FFF;border-radius:16px;padding:40rpx 48rpx;width:560rpx;text-align:center}
.login-modal-title{font-size:36rpx;font-weight:600;color:#1A1A2E;display:block;margin-bottom:12rpx}
.login-modal-desc{font-size:28rpx;color:#8A8AA0;display:block;margin-bottom:40rpx}
.btn-primary{width:100%;height:88rpx;background:#4A6CF7;border-radius:8px;color:#FFF;font-size:32rpx;font-weight:600;line-height:88rpx;border:none;margin-bottom:16rpx}
.btn-cancel{width:100%;height:80rpx;background:#FFF;border-radius:8px;color:#8A8AA0;font-size:28rpx;line-height:80rpx;border:2rpx solid #E8E8E8}

/* Pay Modal */
.pay-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:999;display:flex;align-items:center;justify-content:center}
.pay-modal{background:#FFF;border-radius:16px;width:620rpx;overflow:hidden}
.pay-modal-header{background:#4A6CF7;padding:36rpx 40rpx 28rpx;text-align:center;flex-shrink:0}
.pay-modal-title{font-size:36rpx;font-weight:700;color:#FFF;display:block}
.pay-modal-sub{font-size:24rpx;color:rgba(255,255,255,0.85);display:block;margin-top:8rpx}
.pay-modal-body{padding:8rpx 40rpx 0}
.pay-info-row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #F0F0F4}
.pay-label{font-size:28rpx;color:#8A8AA0;flex-shrink:0}
.pay-value{font-size:28rpx;color:#1A1A2E;font-weight:600;text-align:right;flex:1;margin-left:32rpx;word-break:break-all}
.pay-value.pay-discount{color:#FF5252}
.pay-divider{height:2rpx;background:#E8E8E8;margin:8rpx 0 0}
.pay-total-row{border-bottom:none;padding-top:28rpx;padding-bottom:28rpx}
.pay-total-label{font-size:30rpx;font-weight:600;color:#1A1A2E}
.pay-total{color:#4A6CF7;font-size:42rpx;font-weight:700}
.pay-modal-footer{display:flex;gap:24rpx;padding:8rpx 40rpx 40rpx}
.pay-btn-cancel{flex:1;height:88rpx;line-height:84rpx;font-size:30rpx;margin:0}
.pay-btn-confirm{flex:1;height:88rpx;line-height:88rpx;font-size:30rpx;margin:0}