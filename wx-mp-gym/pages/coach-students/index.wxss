.page-coach-students{padding:20px 16px 70px;min-height:100vh;background:#F5F6FA;box-sizing:border-box}.page-header{margin-bottom:16px}.page-title{font-size:20px;font-weight:600;color:#1A1A2E}.search-bar{margin-bottom:12px}.search-input{width:100%;height:36px;background:#FFF;border-radius:8px;padding:0 12px;font-size:14px;color:#1A1A2E;border:1px solid #E8E8E8;box-sizing:border-box}.student-card{background:#FFF;border-radius:12px;padding:12px;margin-bottom:10px;display:flex;align-items:center;box-shadow:0 2px 12px rgba(0,0,0,.06)}.student-avatar{width:44px;height:44px;border-radius:50%;background:#E8E8E8;flex-shrink:0}.student-info{flex:1;margin-left:12px}.student-name{font-size:16px;font-weight:500;color:#1A1A2E;display:block}.student-phone{font-size:12px;color:#8A8AA0;display:block;margin-top:2px}.student-last{font-size:12px;color:#8A8AA0;display:block;margin-top:2px}.student-count{font-size:12px;color:#4A6CF7;display:block;margin-top:2px}.student-arrow{color:#CCC;font-size:16px}.empty-state{text-align:center;padding:60px 0;color:#8A8AA0;font-size:14px}