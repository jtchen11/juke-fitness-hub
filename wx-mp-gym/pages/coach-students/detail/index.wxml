<view class="page-student-detail">
  <view class="profile-card">
    <view class="avatar">{{student.name ? student.name[0] : '?'}}</view>
    <view class="profile-info">
      <text class="student-name">{{student.name}}</text>
      <text class="student-phone">{{student.phone || '暂无'}}</text>
      <text class="student-level">{{student.level || '普通会员'}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">体测历史</text>
    <view class="fitness-card" wx:for="{{fitnessRecords}}" wx:key="id">
      <text class="fitness-date">{{item.testDate}}</text>
      <view class="fitness-metrics">
        <text class="metric">体重: {{item.weightKg || '-'}}kg</text>
        <text class="metric">体脂: {{item.bodyFatPercent || '-'}}%</text>
        <text class="metric">肌肉: {{item.muscleMassKg || '-'}}kg</text>
      </view>
    </view>
    <view wx:if="{{fitnessRecords.length===0}}" class="empty">暂无体测记录</view>
  </view>

  <view class="section">
    <text class="section-title">上课记录</text>
    <view class="booking-card" wx:for="{{bookings}}" wx:key="id">
      <text class="booking-name">{{item.name || item.typeLabel}}</text>
      <text class="booking-time">{{item.bookingTime || item.appointmentTime}}</text>
      <text class="booking-status {{item.status}}">{{item.status}}</text>
    </view>
    <view wx:if="{{bookings.length===0}}" class="empty">暂无上课记录</view>
  </view>
</view>